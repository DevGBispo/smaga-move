{
  "name": "smaga-move",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite apps/operacional",
    "dev:operacional": "vite apps/operacional",
    "dev:admin": "vite apps/admin",
    "build": "npm run build:operacional",
    "build:operacional": "tsc -p apps/operacional/tsconfig.json && vite build apps/operacional",
    "build:admin": "tsc -p apps/admin/tsconfig.json && vite build apps/admin",
    "typecheck": "tsc -p apps/operacional/tsconfig.json && tsc -p apps/admin/tsconfig.json",
    "preview:admin": "vite preview --outDir apps/admin/dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.0"
  }
}
